choices = Array[Dictionary]([{"text": "문양을 기록한다.", "result_text": "섬에 단순한 생존 이상의 무언가가 있다는 단서가 남았다.", "results": {"items": {"stone": 1}, "partner": {"trust": 2}, "flags": ["found_strange_marking"]}}, {"text": "오늘은 깊이 파고들지 않는다.", "result_text": "문양은 기억 속에 남았지만 우선 생존을 택했다.", "results": {"partner": {"mood": 2}, "flags": ["found_strange_marking"]}}])
